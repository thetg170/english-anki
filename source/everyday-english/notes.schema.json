{
  "deck": "Everyday English",
  "notetype": "EN_Everyday_Sentence_v1",
  "fields": ["Key", "Topic", "SituationVI", "Answer", "Pattern", "Variations", "NoteVI", "PracticeVI"],
  "templates": {
    "Say the sentence": {
      "Front": "<div class=wrap><div class=topic>{{Topic}}</div><div class=prompt>{{SituationVI}}</div><div class=instruction>Nói thành tiếng một câu ngắn bằng tiếng Anh trước khi lật.</div></div>",
      "Back": "<div class=wrap>{{FrontSide}}<hr><div class=label>Một cách nói tự nhiên</div><div class=answer>{{Answer}}</div><div class=audio>{{tts en_US:Answer}}</div><div class=label>Mẫu dùng lại</div><div class=pattern>{{Pattern}}</div><div class=note>{{NoteVI}}</div><div class=label>Thử thay đổi</div><div class=variations>{{Variations}}</div><div class=label>Tự nói câu mới</div><div>{{PracticeVI}}</div></div>"
    }
  },
  "css": ".card{font-family:system-ui,-apple-system,sans-serif;font-size:19px;line-height:1.5;text-align:left;color:#1f2430;background:#f5f6f8;padding:22px}.wrap{max-width:620px;margin:auto}.topic{font-size:13px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:#4366a7}.prompt{font-size:25px;font-weight:650;margin:18px 0}.instruction{font-size:15px;color:#8b3e67;margin-top:22px}.label{font-size:12px;font-weight:700;text-transform:uppercase;color:#6f7786;margin-top:18px}.answer{font-size:25px;font-weight:650;color:#16704e}.pattern{font-weight:650}.note{font-size:15px;color:#626977;margin-top:5px}.variations{font-size:17px}.audio{margin-top:6px}hr{border:0;border-top:1px solid #c8ccd4;margin:22px 0}.nightMode .card,.card.nightMode{background:#1b1d22;color:#e8e9ed}.nightMode .answer{color:#77d6ad}.nightMode .note{color:#adb4c1}"
}
