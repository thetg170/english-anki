{
  "deck": "Everyday English",
  "notetype": "EN_Everyday_PDF_Drill_v1",
  "fields": ["Key", "Topic", "Prompt", "Answer", "Alternative", "Pattern", "Source"],
  "templates": {
    "Say it aloud": {
      "Front": "<div class=wrap><div class=topic>{{Topic}}</div><div class=prompt>{{Prompt}}</div><div class=instruction>Nói thành tiếng trước khi lật thẻ.</div></div>",
      "Back": "<div class=wrap>{{FrontSide}}<hr><div class=answer>{{Answer}}</div>{{#Alternative}}<div class=alternative>Cách khác: {{Alternative}}</div>{{/Alternative}}{{#Pattern}}<div class=pattern>{{Pattern}}</div>{{/Pattern}}<div class=source>{{Source}}</div><div class=audio>{{tts en_US:Answer}}</div></div>"
    }
  },
  "css": ".card{font-family:system-ui,-apple-system,sans-serif;font-size:19px;line-height:1.5;text-align:left;color:#1f2430;background:#f5f6f8;padding:22px}.wrap{max-width:620px;margin:auto}.topic{font-size:13px;font-weight:700;color:#4366a7}.prompt{font-size:24px;font-weight:650;margin:18px 0}.instruction{font-size:15px;color:#8b3e67}.answer{font-size:25px;font-weight:650;color:#16704e}.alternative,.pattern{margin-top:10px}.pattern{font-weight:600}.source{font-size:13px;color:#69717e;margin-top:16px}.audio{margin-top:6px}hr{border:0;border-top:1px solid #c8ccd4;margin:22px 0}.nightMode .card,.card.nightMode{background:#1b1d22;color:#e8e9ed}.nightMode .answer{color:#77d6ad}.nightMode .source{color:#adb4c1}"
}
